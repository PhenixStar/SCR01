#!/usr/bin/env bash
# scr01 - friendly front door for the SCR01 toolkit.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cmd="${1:-menu}"
case "$cmd" in
  doctor) shift; exec bash "$HERE/scripts/scr01-doctor.sh" "$@";;
  reset)  shift; exec bash "$HERE/scripts/scr01-reset.sh" "$@";;
  setup)  shift; exec bash "$HERE/scripts/scr01-setup.sh" "$@";;
  5g)     shift; exec bash "$HERE/scripts/scr01-5g.sh" "$@";;
  apn)    shift; exec bash "$HERE/scripts/scr01-apn.sh" "$@";;
  build-thor) shift; exec bash "$HERE/tools/build-thor.sh" "$@";;
  log)    shift; tail -n "${1:-20}" "${SCR01_LOG:-$HOME/.local/share/scr01/runs.log}" 2>/dev/null || echo "no runs logged yet";;
  menu|*)
    cat <<'TXT'
SCR01 toolkit - Samsung Galaxy 5G Mobile Wi-Fi (SM-H412J)

  scr01 doctor         Read-only readiness report: what's ready to run, and why
  scr01 reset [--yes]  Factory reset via Thor/Odin, no SamFW (--yes = non-interactive)
  scr01 setup [--check] Start-as-new: English + keyboard + 5G-preferred (--check = dry-run)
  scr01 5g [--guide]   Report/attempt 5G-for-PH; --guide walks the on-device band lock
  scr01 apn [name]     Guided APN setup (smart|globe|dito); scr01 apn --verify checks data
  scr01 log [N]        Show the last N run-log lines
  scr01 build-thor     Build the Thor flasher from source (first-time setup)

Typical flow after a reset:  scr01 reset  ->  (finish on-screen setup)  ->  scr01 setup
Not sure what's ready?  scr01 doctor
TXT
    ;;
esac
